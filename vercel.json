{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/intelligence.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/intelligence?route=:path*" }
  ]
}
